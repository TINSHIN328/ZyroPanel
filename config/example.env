# Zyro Hosting Panel - Environment Configuration
# Copy this to .env and customize

# Panel port (DO NOT use 22891 - that's the existing MC server)
PORT=22892

# JWT secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-secret

# Admin account (created automatically on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Server storage directory
SERVERS_BASE=/var/lib/zyro-servers

# Database path
DB_PATH=/opt/zyro-panel/data/zyro.db

# Java path
JAVA_PATH=/usr/bin/java

# Frontend static files path
FRONTEND_PATH=/opt/zyro-panel/frontend/dist

# CORS origin (use * for any, or specify your domain)
CORS_ORIGIN=*
